# Example .env file - DO NOT commit your real keys. Copy to `.env` and fill in values.
# Rename to `.env` (no `.example`) and add real values locally.

# IMPORTANT: This example must NOT contain real API keys. If you previously pasted a key here,
# revoke it in the provider dashboard immediately and replace it with a new key stored only locally.

OPENAI_API_KEY=your_openai_api_key_here
